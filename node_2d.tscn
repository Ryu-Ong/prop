[sub_resource type="GDScript" id="GDScript_rj586"]
script/source = "@tool
extends TileMapLayer

func _ready():
	generate_waiting_box()

func generate_waiting_box():
	var center = Vector2i(468, 468)
	for x in range(-75, 75):
		for y in range(-75, 75):
			var cell = center + Vector2i(x, y)
			if (cell.x + cell.y) % 2 == 0:
				set_cell(cell, 1, Vector2i(0, 0))
			else:
				set_cell(cell, 6, Vector2i(0, 0))
"

